{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "tags": [
    "nmmo",
    "mmo",
    "pufferlib"
  ],
  "episode_timeout_minutes": 60,
  "game": {
    "name": "nmmo",
    "replay_viewer": {
      "bundle": "static-replay-viewer"
    },
    "description": "PufferLib's Ocean NMMO3 (Neural MMO 3) as a Coworld: a persistent 512x512 survival world, bit-exact with the upstream training environment (same C sim compiled to wasm, same 1707-byte observations and 26-way discrete actions). Eight free-for-all agents harvest resources, fight enemies, level combat and profession skills, and equip gear; death or 500-tick stagnation respawns an agent in place. Episodes end at the tick cap; seats are ranked by cumulative min(combat, profession) level over their lives. Replays re-simulate deterministically in a static wasm viewer from the recorded seed and per-tick action log. NOTE: schema sections below are inherited from the moba template and are rewritten in Phase N2 (results/config) and N5 (packaging).",
    "owner": "daveey@softmax.com",
    "runnable": {
      "type": "game",
      "image": "{{GAME_IMAGE}}",
      "run": [
        "python",
        "-m",
        "cogame_nmmo.server"
      ],
      "source_url": "https://github.com/Metta-AI/cogame-nmmo/tree/main"
    },
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "players"
      ],
      "properties": {
        "tokens": {
          "description": "One connection token per player seat, indexed by seat slot. Injected by the runner; never authored.",
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "players": {
          "description": "One player display-name object per seat, indexed by seat slot. players x heroes_per_seat must equal 10: ten seats with heroes_per_seat 1, or two seats with heroes_per_seat 5.",
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "seed": {
          "description": "Deterministic sim seed. Omitted: the server derives a fresh random seed and records it in results and the replay header.",
          "type": "integer"
        },
        "max_ticks": {
          "description": "Tick cap; reaching it ends the episode with an Ancient-health tiebreak.",
          "type": "integer",
          "minimum": 1,
          "default": 40000
        },
        "heroes_per_seat": {
          "description": "Heroes each seat controls: 1 (ten seats, one hero each) or 5 (two seats, one full team each).",
          "type": "integer",
          "enum": [
            1,
            5
          ],
          "default": 1
        },
        "tick_deadline_ms": {
          "description": "Per-tick action deadline in milliseconds; a late/missing/malformed reply plays the no-op action for that seat's heroes.",
          "type": "integer",
          "minimum": 1,
          "default": 1000
        },
        "player_connect_timeout_seconds": {
          "description": "Seconds to wait for all seats to connect before starting; seats that never connect play no-op and are reported to COGAME_PLAYER_FAILURE_URI.",
          "type": "number",
          "minimum": 0,
          "default": 180
        },
        "wall_clock_budget_seconds": {
          "description": "Engine wall-clock hard stop: a slow episode ends itself with end_reason wall_clock (ancient-health tiebreak, artifacts written) once this much real time has elapsed. Default: min(0.9 x episode_timeout_minutes x 60, max_ticks x tick_deadline_ms / 1000) - always under the platform's episode_timeout_minutes container kill, which would lose results and replay.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "num_agents": {
          "description": "Number of agent seats; must equal the player slot count. Used by the platform ladder service for block seating; ignored by the game server.",
          "type": "integer",
          "minimum": 2,
          "maximum": 10,
          "default": 10
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "names",
        "scores",
        "win",
        "team",
        "winner",
        "end_reason",
        "final_tick",
        "seed",
        "reward_sums",
        "ancient_healths",
        "agent_stats",
        "noop_ticks",
        "dead_seats",
        "noop_causes"
      ],
      "properties": {
        "names": {
          "description": "One player name per seat, in seat-slot order.",
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "scores": {
          "description": "One scalar score per seat: win 1.0, draw 0.5, loss 0.0.",
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "number"
          }
        },
        "win": {
          "description": "One win flag per seat.",
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "boolean"
          }
        },
        "team": {
          "description": "One team name per seat.",
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "string",
            "enum": [
              "radiant",
              "dire"
            ]
          }
        },
        "winner": {
          "description": "Winning team: 0 radiant, 1 dire, null draw.",
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            0,
            1,
            null
          ]
        },
        "end_reason": {
          "description": "Why the episode ended: an Ancient fell, the tick cap was reached, the engine's wall-clock budget expired (tick_cap and wall_clock share the ancient-health tiebreak), or the sim reported an internal fault (sim_fault: no winner, draw scores, partial replay).",
          "type": "string",
          "enum": [
            "ancient",
            "tick_cap",
            "wall_clock",
            "sim_fault"
          ]
        },
        "final_tick": {
          "description": "Sim tick at episode end.",
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "description": "The deterministic sim seed the episode ran with.",
          "type": "integer"
        },
        "reward_sums": {
          "description": "Per-seat sum of the sim's per-hero training rewards over the episode.",
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "number"
          }
        },
        "ancient_healths": {
          "description": "Remaining Ancient health at episode end: [radiant, dire].",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "agent_stats": {
          "description": "Per-hero end-of-episode stats, indexed by hero pid (0-4 radiant, 5-9 dire).",
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "kills",
              "deaths",
              "towers_killed",
              "creeps_killed",
              "neutrals_killed",
              "xp",
              "damage_dealt",
              "damage_received",
              "healing_dealt",
              "healing_received"
            ],
            "properties": {
              "level": {
                "type": "integer"
              },
              "kills": {
                "type": "integer"
              },
              "deaths": {
                "type": "integer"
              },
              "towers_killed": {
                "type": "integer"
              },
              "creeps_killed": {
                "type": "integer"
              },
              "neutrals_killed": {
                "type": "integer"
              },
              "xp": {
                "type": "integer"
              },
              "damage_dealt": {
                "type": "integer"
              },
              "damage_received": {
                "type": "integer"
              },
              "healing_dealt": {
                "type": "integer"
              },
              "healing_received": {
                "type": "integer"
              }
            }
          }
        },
        "noop_ticks": {
          "description": "Per-seat count of ticks played as the no-op fallback (late, missing, malformed, or dead seat).",
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dead_seats": {
          "description": "Per-seat strike-rule dead flag at episode end (10 consecutive missed ticks marks a seat dead; a valid reply revives it).",
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "boolean"
          }
        },
        "noop_causes": {
          "description": "Per-seat NOOP-fallback cause counters. timeout/malformed/disconnected/host_error partition noop_ticks; wrong_tick counts mis-addressed reply messages at the transport (such a tick also counts as timeout).",
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timeout",
              "malformed",
              "wrong_tick",
              "disconnected",
              "host_error"
            ],
            "properties": {
              "timeout": {
                "type": "integer",
                "minimum": 0
              },
              "malformed": {
                "type": "integer",
                "minimum": 0
              },
              "wrong_tick": {
                "type": "integer",
                "minimum": 0
              },
              "disconnected": {
                "type": "integer",
                "minimum": 0
              },
              "host_error": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/cogame-nmmo/blob/main/docs/PROTOCOL.md"
      },
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/cogame-nmmo/blob/main/docs/PROTOCOL.md"
      }
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/cogame-nmmo/blob/main/README.md"
      },
      "pages": [
        {
          "id": "porting.md",
          "title": "Porting PufferLib envs",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/cogame-nmmo/blob/main/docs/PORTING.md"
          }
        }
      ]
    }
  },
  "player": [
    {
      "id": "baseline",
      "name": "baseline",
      "type": "player",
      "description": "Upstream PufferLib pretrained policy (moba_weights.bin) run through the vendored puffernet forward pass compiled to wasm - the exact network the sim was trained with. Image placeholder is replaced at deploy time.",
      "image": "{{PLAYER_IMAGE}}",
      "run": [
        "python",
        "-m",
        "players.baseline_player"
      ],
      "source_url": "https://github.com/Metta-AI/cogame-nmmo/tree/main/players",
      "resources": {
        "requests": {
          "cpu": "500m",
          "memory": "512Mi"
        },
        "limits": {
          "cpu": "2"
        }
      }
    }
  ],
